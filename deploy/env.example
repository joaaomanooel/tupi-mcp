TUPI_OCTOPRINT_API_KEY=SUBSTITUA-CHAVE-DE-LEITURA
TUPI_OCTOPRINT_SERIAL_DEVICE=/dev/serial/by-id/SUBSTITUA-PELO-IDENTIFICADOR-USB
TUPI_OCTOPRINT_SERIAL_GID=SUBSTITUA-PELO-GID-DIALOUT
TUPI_MCP_ENABLED_TOOLS=
# Limites físicos por implantação em JSON estrito, sem defaults. Campos não
# reconhecidos ou JSON inválido desabilitam todos os controles físicos;
# faixas incompletas ou inválidas desabilitam o domínio afetado. As ferramentas
# físicas também exigem entrada em TUPI_MCP_ENABLED_TOOLS. Exemplo ilustrativo
# e desabilitado: substitua pelos limites reais da impressora antes de habilitar.
# TUPI_MCP_PHYSICAL_LIMITS={"axes":{"x":{"travel":{"min":-1,"max":1},"speed":{"min":1,"max":1}},"y":{"travel":{"min":-1,"max":1},"speed":{"min":1,"max":1}},"z":{"travel":{"min":-1,"max":1},"speed":{"min":1,"max":1}}},"heaters":{"tool0":{"temperature":{"min":0,"max":1},"offset":{"min":-1,"max":1}}},"extrusion":{"length":{"min":-1,"max":1},"speed":{"min":1,"max":1},"minimumTemperature":1}}
